{
  "extends": "@yoshinani/style-guide/typescript/react-library",
  "compilerOptions": {
    "target": "esnext",
    "lib": ["dom", "esnext"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "declaration": false,
    "declarationMap": false,
    "noEmit": true,
    "allowSyntheticDefaultImports": true,
    "types": ["@emotion/react/types/css-prop"]
  },
  "include": [
    "./src/**/*",
    "./gatsby-node.ts",
    "./gatsby-config.ts",
    "./gatsby-browser.ts",
    "./gatsby-ssr.tsx"
  ],
  "exclude": ["./.yarn/unplugged/**/*"]
}
