{
  "name": "fukke.cafe",
  "version": "1.0.0",
  "private": true,
  "description": "https://fukke.cafe",
  "engines": {
    "node": ">=25.9.0"
  },
  "author": "FukeKazki",
  "keywords": [
    "gatsby"
  ],
  "scripts": {
    "develop": "gatsby develop",
    "start": "gatsby develop",
    "build": "gatsby build",
    "serve": "gatsby serve",
    "clean": "gatsby clean",
    "typecheck": "tsc --noEmit",
    "format": "biome format --write .",
    "check": "biome check --write .",
    "lint": "eslint .",
    "deploy": "firebase deploy"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mdx-js/react": "^2.3.0",
    "@reach/disclosure": "^0.18.0",
    "firebase-tools": "^15.17.0",
    "gatsby": "^5.16.1",
    "gatsby-plugin-emotion": "^8.16.0",
    "gatsby-plugin-mdx": "^5.16.0",
    "gatsby-plugin-sharp": "^5.16.0",
    "gatsby-plugin-sitemap": "^6.16.0",
    "gatsby-remark-autolink-headers": "^6.16.0",
    "gatsby-remark-images": "^7.16.0",
    "gatsby-remark-katex": "^7.16.0",
    "gatsby-remark-prismjs": "^7.16.0",
    "gatsby-remark-prismjs-title": "^1.0.0",
    "gatsby-source-filesystem": "^5.16.0",
    "gatsby-transformer-sharp": "^5.16.0",
    "katex": "^0.16.25",
    "prismjs": "^1.30.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-intersection-observer": "^10.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.0",
    "@types/node": "^25.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@yoshinani/style-guide": "^0.17.11",
    "eslint": "^9.31.0",
    "lint-staged": "^17.0.0",
    "typescript": "^5.9.3"
  },
  "packageManager": "pnpm@10.33.4",
  "pnpm": {
    "overrides": {
      "msgpackr": "^2.0.1",
      "lmdb": "^3.5.4"
    },
    "onlyBuiltDependencies": [
      "core-js",
      "core-js-pure",
      "es5-ext",
      "gatsby",
      "gatsby-cli",
      "lmdb",
      "msgpackr-extract",
      "protobufjs",
      "sharp"
    ],
    "peerDependencyRules": {
      "allowedVersions": {
        "gatsby-remark-katex>katex": "0.16.0"
      }
    }
  }
}
